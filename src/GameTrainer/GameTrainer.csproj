<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 必须保持 Exe（控制台子系统）：
         WinExe 虽然双击不闪黑框，但 GUI 子系统进程不被 shell 同步等待，
         `& GameTrainer.exe profiles > out.txt` 会得到 0 字节（实测）。
         命令行是本工具的主要用法，不能牺牲。
         双击闪黑框由 Program.HideOwnConsoleIfLaunchedByExplorer() 处理。 -->
    <OutputType>Exe</OutputType>
    <!-- exe 图标：由 tools/IconGen 生成，与 GUI 品牌方标同色 -->
    <ApplicationIcon>..\..\assets\gametrainer.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameTrainer</AssemblyName>
    <RootNamespace>GameTrainer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 版本由 Directory.Build.props 的 GameTrainerVersion 统一注入，不在项目里写死 -->
    <AssemblyVersion>$(GameTrainerVersion).0</AssemblyVersion>
    <FileVersion>$(GameTrainerVersion).0</FileVersion>
    <InformationalVersion>$(GameTrainerVersion)</InformationalVersion>
    <Product>GameTrainer</Product>
    <Description>单机游戏内存 / 存档修改器</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试项目需要访问 internal 的纯函数类（AobPattern / ValueCodec / Semantics 等）。
         只开放给测试程序集，不改变生产代码的可见性。 -->
    <InternalsVisibleTo Include="GameTrainer.Tests" />
  <!-- 更新器需要复用清单验签、事务安装与信任根，不重复实现一遍 -->
  <InternalsVisibleTo Include="GameTrainer.Updater" />
  </ItemGroup>

</Project>
