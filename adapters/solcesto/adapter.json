{
  "id": "solcesto",
  "name": "Sol Cesto",
  "engine": "construct3",
  "exe": "SolCesto.exe",
  "mode": "allow",

  "connection": {
    "debugPort": 9222,
    "titleFilter": "SolCesto",
    "installDir": "E:\\Games\\Sol Cesto",
    "launchTimeoutSec": 30
  },

  "engineOptions": {
    "localStorageDb": "c3-localstorage-1llb2l72gcf",
    "objectStore": "keyvaluepairs",
    "runtimePath": "self.c3_runtimeInterface._localRuntime"
  },

  "bindings": [
    {
      "semantic": "health",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "vie",
      "valueType": "number",
      "range": [0, 9999],
      "realtime": true,
      "note": "实测 5→10 界面立即刷新"
    },
    {
      "semantic": "health_max",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "vieMax",
      "valueType": "number",
      "range": [1, 9999],
      "realtime": true,
      "note": "实测 5→10"
    },
    {
      "semantic": "gold",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "or",
      "valueType": "number",
      "range": [0, 9999999],
      "realtime": true,
      "note": "局内金币，实测 0→999"
    },
    {
      "semantic": "gold_total",
      "kind": "indexeddb_key",
      "storageKey": "orEver",
      "valueType": "number",
      "range": [0, 99999999],
      "realtime": false,
      "note": "累计金币，需重载页面"
    },
    {
      "semantic": "energy",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "capacite",
      "valueType": "number",
      "range": [0, 999],
      "realtime": true,
      "note": "界面显示的能量数字，实测 1→10"
    },
    {
      "semantic": "energy_charge",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "capacite_seuilActuel",
      "valueType": "number",
      "range": [0, 999],
      "realtime": true,
      "note": "走路累积进度，实测 0→4"
    },
    {
      "semantic": "energy_charge_max",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "capacite_seuilMax",
      "valueType": "number",
      "range": [1, 999],
      "realtime": true,
      "note": "累积上限，默认 4"
    },
    {
      "semantic": "attack",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "pouvoir_force",
      "valueType": "number",
      "range": [0, 999],
      "realtime": true,
      "note": "力量，实测 2→20"
    },
    {
      "semantic": "magic",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "pouvoir_magie",
      "valueType": "number",
      "range": [0, 999],
      "realtime": true
    },
    {
      "semantic": "defense",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "bouclierActif",
      "valueType": "number",
      "range": [0, 999],
      "realtime": true,
      "note": "护盾值"
    },
    {
      "semantic": "capacity",
      "kind": "instance_var",
      "objectName": "heros",
      "varName": "inventaireMax",
      "valueType": "number",
      "range": [1, 999],
      "realtime": true,
      "note": "背包容量"
    }
  ],

  "notes": {
    "stack": "NW.js 0.86 / Chromium 123 / Construct 3 导出",
    "probedAt": "2026-10-21",
    "steps": [
      "1. 用 --remote-debugging-port=9222 启动，CDP /json/list 取到页面目标",
      "2. 页面内 self.c3_runtimeInterface._localRuntime 拿到 Construct 运行时",
      "3. GetAllObjectClasses() 枚举 730 个类，其中 heros 承载局内数值",
      "4. 实例变量通过 _GetAllInstanceVariableNames() + GetInstanceVariableValue(索引) 读取",
      "5. 写入用 SetInstanceVariableValue(索引, 值)，实时生效",
      "6. 局外数据在 IndexedDB 的 c3-localstorage-<projectId>/keyvaluepairs"
    ],
    "pitfalls": [
      "SetInstanceVariableValue 参数顺序是 (索引, 值)，写反会静默失败或抛 RangeError",
      "GetInstanceVariableValue 只接受索引，传变量名返回 0",
      "局内对象（heros 等）只有进入对局才有实例；主页阶段探测不到",
      "手工解析 leveldb WAL 不可靠，or 键的字节模式会误命中 mendiantLore 内部片段",
      "jsset 打印写前值时 NaN 会被序列化成 null，容易误判"
    ],
    "keyFindings": [
      "运行时入口: self.c3_runtimeInterface._localRuntime",
      "局内数值对象: heros（35 个实例变量）",
      "局外存储: IndexedDB c3-localstorage-1llb2l72gcf / keyvaluepairs",
      "IndexedDB 键: or(局外金币) / orEver(累计) / meta(成就数组) / mendiantLore(图鉴)"
    ]
  }
}